# Copy this file to .env and replace the values with your real ones.
# .env is in .gitignore, so it will never be committed.
DISCORD_TOKEN=put-your-bot-token-here

# Your own Discord user ID: you get the weekly database backup in your DMs and can use /backup.
# To find it: Discord Settings -> Advanced -> turn on Developer Mode, then right-click your name -> Copy User ID.
OWNER_ID=put-your-user-id-here
