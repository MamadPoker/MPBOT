# Copy this file to .env and replace the values with your real ones.
# .env is in .gitignore, so it will never be committed.
DISCORD_TOKEN=put-your-bot-token-here

# Your own Discord user ID: you get the weekly database backup in your DMs and can use /backup and /servers.
# To find it: Discord Settings -> Advanced -> turn on Developer Mode, then right-click your name -> Copy User ID.
OWNER_ID=put-your-user-id-here

# Twitch live alerts (optional). Create a free app at https://dev.twitch.tv/console/apps (steps in README.md),
# then paste its Client ID and a Client Secret here. Without them, Kick and YouTube alerts still work.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
